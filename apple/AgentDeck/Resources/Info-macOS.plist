<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AgentDeckRemoteObservationContract</key>
	<integer>1</integer>
	<key>AgentDeckRemoteObservationEnvironment</key>
	<string>$(AGENTDECK_ICLOUD_ENVIRONMENT)</string>
	<key>AgentDeckDotSupport</key>
	<string>$(AGENTDECK_DOT_SUPPORT)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>AgentDeck</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!-- RFC 6598 shared space used by explicit Tailscale relay targets.
		     This is not RFC 1918 local space; keep the HTTP exception CIDR-scoped. -->
		<key>NSExceptionDomains</key>
		<dict>
			<key>100.64.0.0/10</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>AgentDeck connects to iDotMatrix LED displays over Bluetooth to show live session status.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_agentdeck._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>AgentDeck uses the camera to scan QR codes for bridge pairing.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>AgentDeck discovers and connects to local bridge servers on your network.</string>
	<key>NSLocationUsageDescription</key>
	<string>AgentDeck uses a coarse location to provide local weather context on your Dashboard and paired displays.</string>
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>AgentDeck needs microphone access for voice commands to your AI coding agent.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>AgentDeck transcribes your voice commands locally using Apple's on-device speech recognition so your audio never leaves this device.</string>
</dict>
</plist>
