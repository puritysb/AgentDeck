.pio/
.vscode/
*.o
*.d
*.elf
*.bin
*.map
# custom_sdkconfig build artifacts (regenerated from platformio.ini deltas —
# stale copies override the deltas, so they must never be committed)
sdkconfig.defaults
sdkconfig.*
managed_components/
.dummy/

# ESP-IDF scaffolding emitted by pio when a board builds through the IDF path
# (ips10 does). Generated per build, never authored.
CMakeLists.txt
dependencies.lock
# The component manager's backup of src/idf_component.yml, written on the
# first build and never removed. Untracked, it made every later local build
# report GIT_SHA "-dirty" (scripts/git_rev.py reads `git status --porcelain`).
src/idf_component.yml.orig
