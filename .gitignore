# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# workmux task worktrees (AGENTS.md § Worktree auto cleanup)
__worktrees/

# Xcode user-specific state (window/editor state, breakpoints, schemes)
**/xcuserdata/
*.xcuserstate

# Logs
*.log

# Local diagnostic captures from development workflows
diagnostics/
# Playwright MCP browser-session logs and page snapshots (may include logged-in console pages)
.playwright-mcp/

# Local generation output (image/UI exploration runs); artifacts stay on disk
output/

# Temp
*.tmp
test-*.js
/test-*.ts

# Media (use docs/media/ for committed images)
/screenshot*.png
/IMG_*
/*.gif
/*.mov
/*.webp
assets/videos/
assets/screenshots/

# Runtime
compatibility.json

# Generated code (regenerate via: bash scripts/generate-protocol.sh)
# Track generated/protocol/ so CI can catch drift; other subdirs stay ignored.
generated/*
!generated/protocol/

# Coverage
coverage/

# Android signing
android/signing.properties
android/*.jks

# Apple signing & certificates
*.p12
*.cer
*.mobileprovision
*.provisionprofile
*.certSigningRequest
AuthKey_*.p8
private_keys/

# Privacy-thresholded App Store Connect analytics exports (maintainer-local)
reports/app-store-connect/

# Build artifacts
apple/build/
*.profraw
.zig-cache/
.zig-global-cache/
# fm-helper compiled by bridge/scripts/build-fm-helper.mjs (rebuilt via postinstall/build:fm-helper;
# npm packaging still includes it via package.json "files")
bridge/assets/fm-helper/

# Python bytecode
__pycache__/
*.pyc

# ESP32 robot test results
esp32/robot/results/

# Experimental scratch files
scratch-*.ts
scratch-*.js
scratch/
scratch_usb.txt

# Vendored TC002 emulator working copy (has its own .git, 83MB build artifacts)
tools/tc002-emulator/

# Cloned Ulanzi Deck Plugin SDK + simulator (dev tool; re-clone, not committed)
tools/ulanzi-sdk/

# plugin-ulanzi build output (tsc emits into the .ulanziPlugin/plugin folder)
plugin-ulanzi/com.ulanzi.ulanzistudio.agentdeck.ulanziPlugin/plugin/

# Creature simulator generated data (rebuilt by scripts/render-creature-simulator.mjs
# and scripts/render-esp32-sim-frames.mjs)
tools/creature-simulator/sim-data.js
tools/creature-simulator/sim-frames/
tools/creature-simulator/previews/
apple/DerivedData/
