{
  "description": "Whether a same-machine request keeps the daemon's local trust (shared/src/local-trust.ts). Replayed by shared/src/__tests__/local-trust.test.ts against the TypeScript rule and by apple/AgentDeckTests/LocalTrustVectorsTests.swift against LocalTrust.swift. `isLocalAddress` is membership in environment.localAddresses; a case may replace environment.hostNames with its own.",
  "environment": {
    "port": 9120,
    "localAddresses": ["127.0.0.1", "::1", "::ffff:127.0.0.1", "192.168.1.20"],
    "hostNames": ["Studio-Mac.local"]
  },
  "cases": [
    { "note": "a deck plugin or the CLI over loopback", "request": { "method": "GET", "host": "127.0.0.1:9120" }, "verdict": "trusted" },
    { "note": "localhost by name", "request": { "method": "GET", "host": "localhost:9120" }, "verdict": "trusted" },
    { "note": "IPv6 loopback in brackets", "request": { "method": "GET", "host": "[::1]:9120" }, "verdict": "trusted" },
    { "note": "no Host header at all (HTTP/1.0 client)", "request": { "method": "GET" }, "verdict": "trusted" },
    { "note": "this machine's LAN address", "request": { "method": "GET", "host": "192.168.1.20:9120" }, "verdict": "trusted" },
    { "note": "any IP literal: a browser reaches one without DNS, so rebinding cannot produce it", "request": { "method": "GET", "host": "10.0.0.5:9120" }, "verdict": "trusted" },
    { "note": "DNS rebinding: the page's own domain re-resolved to loopback", "request": { "method": "GET", "host": "rebind.example:9120" }, "verdict": "foreign-host" },
    { "note": "this machine's .local name, any case", "request": { "method": "GET", "host": "studio-mac.local:9120" }, "verdict": "trusted" },
    { "note": "this machine's bare host name: macOS resolves a single label through the DNS search domains, which the network answers", "request": { "method": "GET", "host": "Studio-Mac:9120" }, "verdict": "foreign-host" },
    { "note": "a domain built from this machine's name is answered by DNS too", "request": { "method": "GET", "host": "studio-mac.corp.example:9120" }, "verdict": "foreign-host" },
    { "note": "a fully qualified host name is a DNS name, even when it is this machine's", "hostNames": ["studio-mac.corp.example"], "request": { "method": "GET", "host": "studio-mac.corp.example:9120" }, "verdict": "foreign-host" },
    { "note": "no .local name is guessed from a fully qualified one", "hostNames": ["studio-mac.corp.example"], "request": { "method": "GET", "host": "studio-mac.local:9120" }, "verdict": "foreign-host" },
    { "note": "no .local name is guessed from a bare one either: another machine may hold it", "hostNames": ["studio-mac"], "request": { "method": "GET", "host": "studio-mac.local:9120" }, "verdict": "foreign-host" },
    { "note": "a bare host name stays a DNS name when it is all there is", "hostNames": ["studio-mac"], "request": { "method": "GET", "host": "studio-mac:9120" }, "verdict": "foreign-host" },
    { "note": "an entry that is only the suffix names nothing", "hostNames": ["", ".local"], "request": { "method": "GET", "host": "local:9120" }, "verdict": "foreign-host" },
    { "note": "a fully qualified name's trailing dot", "request": { "method": "GET", "host": "studio-mac.local.:9120" }, "verdict": "trusted" },
    { "note": "another machine's .local name", "request": { "method": "GET", "host": "other-mac.local:9120" }, "verdict": "foreign-host" },
    { "note": "a .localhost name resolves to loopback by definition (RFC 6761)", "request": { "method": "GET", "host": "app.localhost:9120" }, "verdict": "trusted" },
    { "note": "a name that resolves to loopback is still a name", "request": { "method": "GET", "host": "127.0.0.1.nip.io:9120" }, "verdict": "foreign-host" },
    { "note": "an unclosed IPv6 bracket", "request": { "method": "GET", "host": "[::1" }, "verdict": "foreign-host" },
    { "note": "a port that is not a number", "request": { "method": "GET", "host": "localhost:abc" }, "verdict": "foreign-host" },
    { "note": "a combining mark after a digit is not a digit", "request": { "method": "GET", "host": "localhost:8\u0301" }, "verdict": "foreign-host" },
    { "note": "only ASCII whitespace is trimmed", "request": { "method": "GET", "host": "\u00a0localhost:9120" }, "verdict": "foreign-host" },
    { "note": "a host port other than the daemon's does not matter", "request": { "method": "GET", "host": "127.0.0.1:9121" }, "verdict": "trusted" },
    { "note": "Host is checked before Origin", "request": { "method": "POST", "host": "rebind.example:9120" }, "verdict": "foreign-host" },
    { "note": "a cross-origin GET keeps local trust: the browser hides the answer unless the route sends ACAO", "request": { "method": "GET", "host": "127.0.0.1:9120", "origin": "https://evil.example" }, "verdict": "trusted" },
    { "note": "HEAD is not checked against Origin", "request": { "method": "HEAD", "host": "127.0.0.1:9120", "origin": "https://evil.example" }, "verdict": "trusted" },
    { "note": "a CORS preflight is not checked against Origin", "request": { "method": "OPTIONS", "host": "127.0.0.1:9120", "origin": "https://evil.example" }, "verdict": "trusted" },
    { "note": "a WebSocket from a local program carries no Origin", "request": { "method": "GET", "upgrade": true, "host": "127.0.0.1:9120" }, "verdict": "trusted" },
    { "note": "a WebSocket from a web page", "request": { "method": "GET", "upgrade": true, "host": "127.0.0.1:9120", "origin": "https://evil.example" }, "verdict": "foreign-origin" },
    { "note": "a WebSocket from a page the daemon served", "request": { "method": "GET", "upgrade": true, "host": "127.0.0.1:9120", "origin": "http://127.0.0.1:9120" }, "verdict": "trusted" },
    { "note": "the daemon's own origin by localhost", "request": { "method": "GET", "upgrade": true, "host": "localhost:9120", "origin": "http://localhost:9120" }, "verdict": "trusted" },
    { "note": "another local server's page", "request": { "method": "GET", "upgrade": true, "host": "127.0.0.1:9120", "origin": "http://127.0.0.1:3000" }, "verdict": "foreign-origin" },
    { "note": "an opaque origin: a sandboxed frame, or a file page in a browser", "request": { "method": "GET", "upgrade": true, "host": "127.0.0.1:9120", "origin": "null" }, "verdict": "foreign-origin" },
    { "note": "an opaque origin in upper case", "request": { "method": "POST", "host": "127.0.0.1:9120", "origin": "NULL" }, "verdict": "foreign-origin" },
    { "note": "the literal file:// a non-browser client sends", "request": { "method": "GET", "upgrade": true, "host": "127.0.0.1:9120", "origin": "file://" }, "verdict": "trusted" },
    { "note": "a rebinding page's origin, isolated from its Host", "request": { "method": "GET", "upgrade": true, "host": "127.0.0.1:9120", "origin": "http://rebind.example:9120" }, "verdict": "foreign-origin" },
    { "note": "an IP with the daemon's port that is not this machine", "request": { "method": "GET", "upgrade": true, "host": "127.0.0.1:9120", "origin": "http://203.0.113.7:9120" }, "verdict": "foreign-origin" },
    { "note": "this machine's LAN address as the origin", "request": { "method": "GET", "upgrade": true, "host": "192.168.1.20:9120", "origin": "http://192.168.1.20:9120" }, "verdict": "trusted" },
    { "note": "IPv6 loopback as the origin", "request": { "method": "GET", "upgrade": true, "host": "[::1]:9120", "origin": "http://[::1]:9120" }, "verdict": "trusted" },
    { "note": "an IPv4-mapped loopback origin", "request": { "method": "GET", "upgrade": true, "host": "127.0.0.1:9120", "origin": "http://[::ffff:127.0.0.1]:9120" }, "verdict": "trusted" },
    { "note": "a browser extension", "request": { "method": "GET", "upgrade": true, "host": "127.0.0.1:9120", "origin": "chrome-extension://abcdefghijklmnop" }, "verdict": "foreign-origin" },
    { "note": "an origin without a port is port 80", "request": { "method": "GET", "upgrade": true, "host": "127.0.0.1:9120", "origin": "http://localhost" }, "verdict": "foreign-origin" },
    { "note": "this machine's .local name as the origin", "request": { "method": "GET", "upgrade": true, "host": "studio-mac.local:9120", "origin": "http://Studio-Mac.local:9120" }, "verdict": "trusted" },
    { "note": "userinfo is never part of an origin", "request": { "method": "GET", "upgrade": true, "host": "127.0.0.1:9120", "origin": "http://user@127.0.0.1:9120" }, "verdict": "foreign-origin" },
    { "note": "a trailing slash from a non-browser client", "request": { "method": "GET", "upgrade": true, "host": "127.0.0.1:9120", "origin": "http://127.0.0.1:9120/" }, "verdict": "trusted" },
    { "note": "an origin with a path is not an origin", "request": { "method": "GET", "upgrade": true, "host": "127.0.0.1:9120", "origin": "http://127.0.0.1:9120/apme" }, "verdict": "foreign-origin" },
    { "note": "a POST from the CLI, the app or a hook carries no Origin", "request": { "method": "POST", "host": "127.0.0.1:9120" }, "verdict": "trusted" },
    { "note": "a cross-origin POST from a web page", "request": { "method": "POST", "host": "127.0.0.1:9120", "origin": "https://evil.example" }, "verdict": "foreign-origin" },
    { "note": "a POST from a page the daemon served (the APME dashboard)", "request": { "method": "POST", "host": "127.0.0.1:9120", "origin": "http://127.0.0.1:9120" }, "verdict": "trusted" },
    { "note": "the method is compared in any case", "request": { "method": "post", "host": "127.0.0.1:9120", "origin": "https://evil.example" }, "verdict": "foreign-origin" },
    { "note": "DELETE changes state too", "request": { "method": "DELETE", "host": "127.0.0.1:9120", "origin": "https://evil.example" }, "verdict": "foreign-origin" },
    { "note": "an Origin of only spaces is no Origin", "request": { "method": "POST", "host": "127.0.0.1:9120", "origin": "  " }, "verdict": "trusted" },
    { "note": "an origin on another machine's port 9120 by name", "request": { "method": "POST", "host": "127.0.0.1:9120", "origin": "http://other-mac.local:9120" }, "verdict": "foreign-origin" },
    { "note": "a page this daemon served through a port forward: both headers carry the forwarded port", "request": { "method": "POST", "host": "127.0.0.1:19120", "origin": "http://127.0.0.1:19120" }, "verdict": "trusted" },
    { "note": "a WebSocket from that page by name", "request": { "method": "GET", "upgrade": true, "host": "localhost:19120", "origin": "http://localhost:19120" }, "verdict": "trusted" },
    { "note": "the address a request was sent to is its host as well as its port", "request": { "method": "POST", "host": "127.0.0.1:19120", "origin": "http://localhost:19120" }, "verdict": "foreign-origin" },
    { "note": "another local server's page posting through the forward", "request": { "method": "POST", "host": "127.0.0.1:19120", "origin": "http://127.0.0.1:3000" }, "verdict": "foreign-origin" },
    { "note": "an origin equal to Host is still not this machine's unless the address is", "request": { "method": "POST", "host": "203.0.113.7:9120", "origin": "http://203.0.113.7:9120" }, "verdict": "foreign-origin" },
    { "note": "a scheme is looked up among the known ones only, never on the object behind them", "request": { "method": "POST", "host": "localhost:9120", "origin": "constructor://localhost:9120" }, "verdict": "foreign-origin" },
    { "note": "a byte-order mark is not an empty Origin", "request": { "method": "POST", "host": "127.0.0.1:9120", "origin": "\ufeff" }, "verdict": "foreign-origin" },
    { "note": "nor is a next-line character", "request": { "method": "POST", "host": "127.0.0.1:9120", "origin": "\u0085" }, "verdict": "foreign-origin" },
    { "note": "the method is upper-cased as ASCII only: a long s is not an S", "request": { "method": "OPTION\u017f", "host": "127.0.0.1:9120", "origin": "https://evil.example" }, "verdict": "foreign-origin" }
  ]
}
