[
  {
    "name": "background wait survives Stop and unrelated tool completion; prompt clears explicitly",
    "steps": [
      {
        "event": "tool_start",
        "payload": {
          "tool_name": "Bash",
          "tool_use_id": "a",
          "tool_input": {
            "command": "gh pr checks 433 --watch",
            "run_in_background": true
          }
        },
        "at": 100,
        "expected": {
          "kind": "ci",
          "provider": "github-actions",
          "pr": 433,
          "phase": "unknown",
          "agentWaiting": true,
          "evidence": "tool_input",
          "openedAt": 100
        }
      },
      {
        "event": "tool_end",
        "payload": {
          "tool_use_id": "other"
        },
        "at": 110,
        "expected": {
          "kind": "ci",
          "provider": "github-actions",
          "pr": 433,
          "phase": "unknown",
          "agentWaiting": true,
          "evidence": "tool_input",
          "openedAt": 100
        }
      },
      {
        "event": "tool_end",
        "payload": {
          "tool_use_id": "a"
        },
        "at": 120,
        "expected": {
          "kind": "ci",
          "provider": "github-actions",
          "pr": 433,
          "phase": "unknown",
          "agentWaiting": true,
          "evidence": "tool_input",
          "openedAt": 100
        }
      },
      {
        "event": "stop",
        "payload": {},
        "at": 130,
        "expected": {
          "kind": "ci",
          "provider": "github-actions",
          "pr": 433,
          "phase": "unknown",
          "agentWaiting": true,
          "evidence": "tool_input",
          "openedAt": 100
        }
      },
      {
        "event": "user_prompt_submit",
        "payload": {},
        "at": 140,
        "expected": null
      }
    ]
  },
