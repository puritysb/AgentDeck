    "ChatEventPayload": {
      "additionalProperties": false,
      "description": "The Gateway's `chat` frame. Shape verified against the emitter itself (`openclaw/dist/server-chat-wgxNCdC3.js` — `emitChatDelta`, `flushBufferedChatDeltaIfNeeded`, `emitChatTerminal`), not assumed.\n\n**This frame is assistant-only.** It carries no user prompt, no tool array and no token accounting — `message.role` is always `'assistant'`. Fields named `prompt`, `tools`, `modelId`, `inputTokens` and `outputTokens` were declared here from an assumed shape and the Gateway has never sent any of them; reading them yielded `undefined` on every real frame, which is why no turn was ever opened for an OpenClaw-app conversation. The prompt, the tool calls and the per-turn model/usage all arrive on `session.message` / `session.tool` instead, and only after `sessions.subscribe`.\n\nSame failure mode, and the same fix, as `ExecApprovalRequestedPayload` below — see the note there.",
      "properties": {
        "agentId": {
          "description": "Agent that owns the session, when not the default one.",
          "type": "string"
        },
        "deltaText": {
          "description": "Incremental text chunk (delta state). Named `deltaText` on the wire.",
          "type": "string"
        },
        "error": {
          "description": "Never sent by the Gateway; `openclaw-hook.ts` fills it from `errorMessage`.",
          "type": "string"
        },
        "errorKind": {
          "description": "Failure classification (error state), e.g. \"unavailable\".",
          "type": "string"
        },
        "errorMessage": {
          "description": "Failure sentence (error state), and the abort reason on `aborted`.",
          "type": "string"
        },
        "message": {
          "additionalProperties": false,
          "description": "Assistant message. `content` is an array of typed blocks.",
          "properties": {
            "content": {},
            "role": {
              "type": "string"
            },
            "timestamp": {
              "type": "number"
            }
          },
          "type": "object"
        },
        "replace": {
          "description": "True when `deltaText` replaces the buffer rather than appending.",
          "type": "boolean"
        },
        "response": {
          "description": "Full assembled response. Never sent by the Gateway — retained because `openclaw-hook.ts` synthesizes it from `message` before building spans.",
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "seq": {
          "description": "Monotonic per-run sequence number.",
          "type": "number"
        },
        "sessionKey": {
          "type": "string"
        },
        "spawnedBy": {
          "description": "Set when this run was spawned by another session (cron, subagent).",
          "type": "string"
        },
        "state": {
          "enum": [
            "delta",
            "final",
            "aborted",
            "error"
          ],
          "type": "string"
        },
        "stopReason": {
          "description": "Why the run stopped.",
          "type": "string"
        },
        "tools": {
          "description": "Never sent by the Gateway. Retained for the same reason as `response`.",
          "items": {
            "$ref": "#/definitions/ChatToolInvocation"
          },
          "type": "array"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
